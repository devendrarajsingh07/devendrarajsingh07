<!-- Generated file: do not edit README.md directly. Edit README.template and config.yml, then run scripts/build_readme.py. -->

<!--Banner-->
<p align="center">
  <img src="assets/banner.svg" width="100%" alt="{{ name }} — {{ role }}" />
</p>

<!--Profile panel-->
<img align="right" width="42%" src="assets/neofetch_panel.svg" alt="Developer profile at a glance" />

<!--Header-->
# Hi, I'm {{ name.split()[0] }}! 👋
*{{ tagline }}*
<br />

<!--Intro-->
<p align="left">{{ intro }}</p>

- 🎓 B.Tech CSE (AI & ML) at **KIIT**, Bhubaneswar — Class of 2028
- 🔋 Research internship at **NoonRay Energy Pvt. Ltd.** in battery electrochemistry ([AI Battery Fast Charging](https://github.com/{{ username }}/AI_Battery_Fast_Charging))
- 🚀 Currently building **[{{ projects[0].name }}]({{ projects[0].github }})**{% if projects[0].demo %} — try the [live demo]({{ projects[0].demo }}){% endif %}
- 🏁 Smart India Hackathon 2026 build: **[MGHSIS](https://github.com/{{ username }}/SIH2026-MGHSIS.)**
- ⚓ NCC Naval Wing cadet with a Grade B certificate
- 🤝 Open to internships, collaborations and ambitious product ideas
- 💻 Visit my [Portfolio](https://{{ website }}) for more about me

<!--Profile views-->
<p align="left">
  <img src="https://komarev.com/ghpvc/?username={{ username }}&label=Profile%20views&color={{ palette.accent | replace('#', '') }}&style=for-the-badge" alt="Profile views" />
</p>

---

<!--Tech stack & latest builds-->
<h2 align="center">Tech stack & latest builds</h2>

<picture>
  <source media="(prefers-color-scheme: dark)" srcset="assets/stack_orbit_dark.svg">
  <source media="(prefers-color-scheme: light)" srcset="assets/stack_orbit_light.svg">
  <img align="left" width="46%" alt="Tech stack: Python, TypeScript, React, FastAPI, PyTorch, PostgreSQL, JavaScript, Next.js, Node.js, Express, Vite, OpenCV, YOLOv8, Hugging Face Transformers, Redis, Qdrant, Docker, Git" src="assets/stack_orbit_dark.svg">
</picture>

<h3 align="left">Currently exploring</h3>
<ul align="left">
{%- for item in exploring %}
  <li>{{ item }}</li>
{%- endfor %}
</ul>

<h3 align="left">Latest builds</h3>
<ul align="left">
{%- for p in projects %}
  <li><a href="{{ p.github }}"><b>{{ p.name }}</b></a> — {{ p.area }} · {{ p.date }}{% if p.demo %} · <a href="{{ p.demo }}">live demo</a>{% endif %}</li>
{%- endfor %}
</ul>
<br clear="left" />
<br />

<!--Stats table-->
<h2 align="center">📊 GitHub Stats 📊</h2>

<table width="100%">
  <tr>
    <td width="50%">
      <h3 align="center"><strong>GitHub Stats</strong></h3>
      <p align="center">
        <a href="https://github.com/{{ username }}">
          <img src="https://github-profile-summary-cards.vercel.app/api/cards/stats?username={{ username }}&theme=tokyonight" alt="GitHub stats" width="100%" />
        </a>
      </p>
    </td>
    <td width="50%">
      <h3 align="center"><strong>Streak Stats</strong></h3>
      <p align="center">
        <a href="https://github.com/{{ username }}">
          <img src="https://streak-stats.demolab.com?user={{ username }}&hide_border=true&background=30,0C1330,1E3A8A&ring=38BDF8&fire=38BDF8&currStreakLabel=38BDF8&currStreakNum=E7F0FF&sideNums=E7F0FF&sideLabels=CFDCF5&dates=8EA2C8&stroke=2D3C68" alt="GitHub streak" width="100%" />
        </a>
      </p>
    </td>
  </tr>
  <tr>
    <td width="50%">
      <h3 align="center"><strong>Latest Project</strong></h3>
      <p align="center">
        <a href="{{ projects[0].github }}">
          <img src="assets/latest_project.svg" alt="Latest project: {{ projects[0].name }}" width="100%" />
        </a>
      </p>
    </td>
    <td width="50%">
      <h3 align="center"><strong>Languages</strong></h3>
      <p align="center">
        <a href="https://github.com/{{ username }}?tab=repositories">
          <img src="https://github-profile-summary-cards.vercel.app/api/cards/repos-per-language?username={{ username }}&theme=tokyonight" alt="Repositories per language" width="100%" />
        </a>
      </p>
    </td>
  </tr>
</table>
<br />

<!--Contribution graph-->
<h2 align="center">📈 Contribution Graph 📈</h2>
